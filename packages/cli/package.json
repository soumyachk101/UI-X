{
  "name": "@ui-x/cli",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "bin": {
    "ui-x": "./src/index.ts"
  },
  "main": "./src/index.ts",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "tsx build.ts",
    "dev": "tsx watch src/index.ts",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@ui-x/registry": "workspace:*",
    "@ui-x/registry-schema": "workspace:*",
    "@ui-x/shared": "workspace:*",
    "commander": "^12.0.0",
    "chalk": "^5.3.0",
    "ora": "^8.0.0",
    "prompts": "^2.4.2",
    "cli-table3": "^0.6.5",
    "fuse.js": "^7.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/commander": "^2.12.2",
    "@types/prompts": "^2.4.0",
    "@types/node": "^22.0.0",
    "tsx": "^4.7.0",
    "typescript": "~5.6.0"
  }
}
