{
  "name": "ui-x",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:accessibility": "vitest run --reporter=verbose --grep 'accessibility|a11y'",
    "test:registry": "vitest run --grep 'registry'",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean && rm -rf node_modules"
  },
  "devDependencies": {
